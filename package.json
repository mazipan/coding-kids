{
  "name": "coding-kids",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit-lessons": "bun scripts/audit-thinking-lessons.mjs",
    "build": "tsc -b && export BUILD_DATE=$(date -u +%Y-%m-%dT%H:%M:%S.000Z) && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "check": "biome check --write",
    "type-check": "tsc -b --noEmit",
    "dev": "vite",
    "format": "biome format --write",
    "lint": "biome lint",
    "test": "bun test",
    "prepare": "[ -n \"$CI\" ] || lefthook install",
    "preview": "vite preview"
  },
  "browserslist": "> 0.5%, last 2 versions, Firefox ESR, not dead",
  "dependencies": {
    "blockly": "^13.4.0",
    "framer-motion": "^14.12.0",
    "lefthook": "^2.2.2",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  }
}
